#!/usr/bin/env bash
# Auto-updates openwiki/ docs before pushing to develop or main.
# Requires: openwiki CLI installed globally, OPENAI_API_KEY set in env.
set -euo pipefail

protected_branches="develop main"
push_target=0

while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  for b in $protected_branches; do
    if [ "$branch" = "$b" ]; then
      push_target=1
    fi
  done
done

if [ "$push_target" -eq 0 ]; then
  exit 0
fi

if ! command -v openwiki >/dev/null 2>&1; then
  echo "pre-push: openwiki CLI not found, skipping doc update (npm install -g openwiki)" >&2
  exit 0
fi

if [ -z "${OPENAI_API_KEY:-}" ]; then
  echo "pre-push: OPENAI_API_KEY not set, skipping doc update" >&2
  exit 0
fi

echo "pre-push: updating openwiki docs..."
OPENWIKI_PROVIDER=openai openwiki code --update --print

if ! git diff --quiet -- openwiki AGENTS.md CLAUDE.md 2>/dev/null || \
   [ -n "$(git status --porcelain -- openwiki AGENTS.md CLAUDE.md 2>/dev/null)" ]; then
  git add openwiki AGENTS.md CLAUDE.md 2>/dev/null || true
  if ! git diff --cached --quiet; then
    git commit -m "docs: update openwiki [skip ci]"
    echo "pre-push: committed openwiki doc updates"
  fi
fi

exit 0
