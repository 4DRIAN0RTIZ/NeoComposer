:"Neandertech","email":"2121100617@soy.utj.edu.mx","timestamp":1784361036},"committer":{"name":"Neandertech","email":"2121100617@soy.utj.edu.mx","timestamp":1784361054},"conventional":true,"merge_commit":false,"statistics":{"files_changed":1,"additions":2,"deletions":6},"extra":null,"github":{"username":null,"pr_title":null,"pr_number":null,"pr_labels":[],"is_first_time":false},"gitlab":{"username":null,"pr_title":null,"pr_number":null,"pr_labels":[],"is_first_time":false},"gitea":{"username":null,"pr_title":null,"pr_number":null,"pr_labels":[],"is_first_time":false},"bitbucket":{"username":null,"pr_title":null,"pr_number":null,"pr_labels":[],"is_first_time":false},"azure_devops":{"username":null,"pr_title":null,"pr_number":null,"pr_labels":[],"is_first_time":false},"raw_message":"fix(changelog): generate docs/changelog.json via direct git-cliff call\n\norhun/git-cliff-action always runs a second internal git-cliff invocation\nappending --context to extract the version output. Passing --context\nthrough our own args duplicated the flag on that internal call, which\nerrored and left docs/changelog.json unwritten (stuck at []). Call the\nbinary the first action step already downloaded directly instead of\nrouting through the action a second time."},{"id":"236caaccd278a4c0861e7481a8d5c011b699ea59","message":"update CHANGELOG.md and docs/changelog.json [skip ci]","body":null,"footers":[],"group":"Chore","breaking_description":null,"breaking":false,"scope":"changelog","links":[],"author":{"name":"github-actions[bot]","email":"github-actions[bot]@users.noreply.github.com","timestamp":1784353983},"committer":{"name":"github-actions[bot]","email":"github-actions[bot]@users.noreply.github.com","timestamp":1784353983},"conventional":true,"merge_commit":false,"statistics":{"files_changed":2,"additions":15,"deletions":2},"extra":null,"github":{"username":null,"pr_title":null,"pr_number":null,"pr_labels":[],"is_first_time":false},"gitlab":{"username":null,"pr_title":null,"pr_num